import java.util.*;
public class Array1
{
    public static void main(String args[])
    {
        Scanner sc=new Scanner(System.in);
        System.out.println("Enter 10 elements in the array");
        int ar[]=new int[10];
        for(int i=0;i<10;i++)
        {
            ar[i]=sc.nextInt();
        }
        System.out.println("The elements in the arrays is: ");
        for(int i=0;i<10;i++)
        {
            System.out.println(ar[i]);
        }
        
    }
}
