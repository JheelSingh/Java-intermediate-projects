import java.util.*;
public class Array2
{
    public static void main(String args[])
    {
        Scanner sc=new Scanner(System.in);
        int a[]=new int[10];
        System.out.println("Enter 10 elements for the array");
        for(int i=0;i<10;i++)
        {
            a[i]=sc.nextInt();
        }
        System.out.println("The elements in the given arrays is:");
        for(int i=0;i<10;i++)
        {
            System.out.print(a[i]+" ");
        }
        int s=0;
        double avg=0.0;
        for(int i=0;i<10;i++)
        {
            s+=a[i];
        }
        avg=s/10.0;
        System.out.println("Sum of the elements in the array : " + s);
        System.out.println("Average of the elements in the array : " + avg);
    }
}
