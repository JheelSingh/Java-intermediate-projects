import java.util.*;
public class Array3
{
    public static void main(String args[])
    {
        Scanner sc=new Scanner(System.in);
        System.out.println("Enter 5 elements for the array proceedings");
        int a[]=new int[5];
        for(int i=0;i<5;i++)
        {
            a[i]=sc.nextInt();
        }
        System.out.println("The elements in the array is : ");
        for(int i=0;i<5;i++)
        {
            System.out.print(a[i]+" ");
        }
        int max=a[0],min=a[0];
        for(int i=0; i<5;i++)
        {
            if(a[i]>max)
            {
                max=a[i];
            }
            if(a[i]<min)
            {
                min=a[i];
            }
        }
        System.out.println("The maximum number is : " + max);
        System.out.println("The minimum number is : " + min);
    }
}
